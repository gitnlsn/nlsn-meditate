      "audio": "18-come-back-to-the-words-whenever-you-like.mp3"
    },
    {
      "wait": 25
    },
    {
      "say": "May I be safe. May I be healthy.",
      "wait": 15,
      "audio": "19-may-i-be-safe-may-i-be-healthy.mp3"
    },
    {
      "say": "May I be kind to myself.",
