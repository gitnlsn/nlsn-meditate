      "audio": "12-may-i-be-healthy.mp3"
    },
    {
      "say": "May I be kind to myself.",
      "wait": 12,
      "audio": "13-may-i-be-kind-to-myself.mp3"
    },
    {
      "say": "May I live with ease.",
      "wait": 15,
      "audio": "14-may-i-live-with-ease.mp3"
    },
    {
      "say": "Repeat whichever words feel right to you.",
      "wait": 20,
      "audio": "15-repeat-whichever-words-feel-right-to-you.mp3"
    },
    {
      "wait": 25
    },
    {
      "say": "If resistance comes up, that's normal.",
