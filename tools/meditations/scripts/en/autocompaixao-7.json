      "wait": 15,
      "audio": "06-imagine-this-person-looking-at-you-with.mp3"
    },
    {
      "say": "Notice what happens in your body as you imagine this.",
      "wait": 16,
      "audio": "07-notice-what-happens-in-your-body-as-you-imagine.mp3"
    },
    {
      "say": "Now let's turn that same attention inward.",
      "wait": 10,
      "audio": "08-now-let-s-turn-that-same-attention-inward.mp3"
    },
    {
      "say": "Bring yourself to mind. How you are today.",
